# Contoh konfigurasi Lema. Salin jadi .env.local untuk pengembangan lokal,
# atau isi sebagai Environment Variables di Vercel untuk versi online.
# Berkas ini tidak boleh memuat nilai rahasia yang sebenarnya.

# WAJIB. API key dari aistudio.google.com.
# Jangan pernah memakai awalan NEXT_PUBLIC_ pada baris ini; nilainya akan ikut
# ke bundle browser dan bisa dibaca siapa saja.
GEMINI_API_KEY=

# Model utama. Rantai cadangan diatur di app/api/lookup/route.ts.
GEMINI_MODEL=gemini-3.8-flash

# Seberapa lama model berpikir sebelum menjawab: low, medium, atau high.
# Bawaan kode adalah low, karena medium membuat satu foto memakan 20 detik
# lebih. Naikkan ke medium hanya kalau uji akurasi menunjukkan maknanya
# jadi kurang tepat. Nilai lain diabaikan dan kembali ke low.
GEMINI_THINKING_LEVEL=low

# Batas jumlah KATA per alamat per hari, bukan jumlah permintaan.
DAILY_LOOKUP_LIMIT=60

# Penghitung batas bersama. Tanpa ini batas hanya berlaku per proses server.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
